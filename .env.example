# SIH26168 -- example environment file. Copy to .env and adjust. .env is gitignored.
#
# Required on Windows: torch 2.14's dynamo ONNX exporter crashes under the cp1252
# console codepage (UnicodeEncodeError on its own progress emoji). See docs/ml_pipeline.md.
PYTHONUTF8=1

# Absolute path to the IO-VNBD dataset root (the directory holding
# "Categorised IOVNB Dataset" and "Uncategorised IOVNB Dataset").
# Raw data is READ-ONLY and lives outside the repository (AGENTS.md 5).
SIH26168_DATASET_ROOT=C:\Users\Shreeyash\OneDrive\Desktop\SIH26168\data raw  IO-VNBD\Synchronised V abd S datasets\Synchronised V abd S datasets

# Global seed for reproducible runs.
SIH26168_SEED=26168
